<Window x:Class="RotaDoSabor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rota do Sabor" Width="980" Height="740" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <!-- Janela única: as telas (UserControls em Views/) são trocadas aqui pelo NavegadorWpf. -->
    <ContentControl x:Name="AreaConteudo" Margin="16">
        <TextBlock Text="Conectando ao banco de dados e preparando dados iniciais..."
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
    </ContentControl>
</Window>
