<UserControl x:Class="RotaDoSabor.Wpf.Views.EnderecosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Meus endereços" Style="{StaticResource Titulo}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnVoltar" Content="Voltar" Click="BtnVoltar_Click" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Bottom">
                    <Button x:Name="BtnNovo" Content="Novo endereço" Click="BtnNovo_Click" />
                    <Button x:Name="BtnPadrao" Content="Definir como padrão" Click="BtnPadrao_Click" />
                    <Button x:Name="BtnExcluir" Content="Excluir" Click="BtnExcluir_Click" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="TxtVazio" Text="Nenhum endereço cadastrado." Style="{StaticResource Dica}" Visibility="Collapsed" />
                <ListBox x:Name="LstEnderecos" DisplayMemberPath="DescricaoComPadrao" SelectionChanged="LstEnderecos_SelectionChanged" />
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtModo" Text="Cadastrar endereço" Style="{StaticResource Subtitulo}" />
                    <Label Content="CEP *" />
                    <TextBox x:Name="TxtCep" MaxLength="9" />
                    <Label Content="Rua / Logradouro *" />
                    <TextBox x:Name="TxtLogradouro" MaxLength="150" />
                    <Label Content="Número *" />
                    <TextBox x:Name="TxtNumero" MaxLength="10" />
                    <Label Content="Complemento" />
                    <TextBox x:Name="TxtComplemento" MaxLength="100" />
                    <Label Content="Bairro *" />
                    <TextBox x:Name="TxtBairro" MaxLength="80" />
                    <Label Content="Cidade *" />
                    <TextBox x:Name="TxtCidade" MaxLength="80" />
                    <CheckBox x:Name="ChkPadrao" Content="Tornar padrão" />
                    <Button x:Name="BtnSalvar" Content="Confirmar" Click="BtnSalvar_Click" FontWeight="Bold" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
