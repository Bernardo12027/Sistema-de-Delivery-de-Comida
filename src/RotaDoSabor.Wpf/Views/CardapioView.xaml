<UserControl x:Class="RotaDoSabor.Wpf.Views.CardapioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- "Banner" da loja (somente texto, sem imagens) -->
        <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="TxtNomeRestaurante" Style="{StaticResource Titulo}" Margin="0" />
                <TextBlock x:Name="TxtAvaliacao" FontSize="15" />
                <TextBlock x:Name="TxtInfo" Foreground="DimGray" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="TxtResumoCarrinho" VerticalAlignment="Center" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnVoltar" Content="Voltar" Click="BtnVoltar_Click" />
                <Button x:Name="BtnCarrinho" Content="Ver carrinho" Click="BtnCarrinho_Click" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dica}"
                   Text="Itens indisponíveis aparecem no cardápio, mas não podem ser adicionados." />

        <DataGrid x:Name="DgProdutos">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo, Mode=OneWay}" Width="60" />
                <DataGridTextColumn Header="Produto" Binding="{Binding Nome, Mode=OneWay}" Width="160" />
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao, Mode=OneWay}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Detalhes" Binding="{Binding Detalhes, Mode=OneWay}" Width="140" />
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="Preço" Binding="{Binding PrecoTexto, Mode=OneWay}" Width="80" />
                <DataGridTextColumn Header="Situação" Binding="{Binding DisponibilidadeTexto, Mode=OneWay}" Width="85" />
                <DataGridTemplateColumn Header="" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="+ Adicionar" Tag="{Binding Id}" IsEnabled="{Binding Disponivel}"
                                    Click="BtnAdicionar_Click" MinWidth="0" Margin="2" Padding="6,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
