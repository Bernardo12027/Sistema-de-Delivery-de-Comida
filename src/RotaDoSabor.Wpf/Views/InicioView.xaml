<UserControl x:Class="RotaDoSabor.Wpf.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
        <TextBlock Text="Rota do Sabor" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="Delivery de comida" Style="{StaticResource Dica}" HorizontalAlignment="Center" Margin="0,0,0,24" />
        <Button x:Name="BtnLogin" Content="Login" Click="BtnLogin_Click" Height="36" />
        <Button x:Name="BtnCadastro" Content="Cadastro" Click="BtnCadastro_Click" Height="36" />
    </StackPanel>
</UserControl>
