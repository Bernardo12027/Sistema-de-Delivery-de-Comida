<UserControl x:Class="RotaDoSabor.Wpf.Views.CadastroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" Width="340">
            <TextBlock Text="Cadastro" Style="{StaticResource Titulo}" />
            <Label Content="Nome completo *" />
            <TextBox x:Name="TxtNome" MaxLength="100" />
            <Label Content="E-mail *" />
            <TextBox x:Name="TxtEmail" MaxLength="150" />
            <Label Content="Nome de usuário * (3 a 30: letras, números, . ou _)" />
            <TextBox x:Name="TxtUsuario" MaxLength="30" />
            <Label Content="Telefone (opcional, com DDD)" />
            <TextBox x:Name="TxtTelefone" MaxLength="20" />
            <Label Content="Senha * (mínimo 6, com letras e números)" />
            <PasswordBox x:Name="PwdSenha" />
            <Label Content="Confirmar senha *" />
            <PasswordBox x:Name="PwdConfirmacao" />
            <Button x:Name="BtnConfirmar" Content="Confirmar" IsDefault="True" Click="BtnConfirmar_Click" Height="34" />
            <Button x:Name="BtnJaTenhoConta" Content="Já tenho conta" Click="BtnJaTenhoConta_Click" />
            <Button x:Name="BtnVoltar" Content="Voltar" Click="BtnVoltar_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
