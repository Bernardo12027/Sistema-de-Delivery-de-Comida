<UserControl x:Class="RotaDoSabor.Wpf.Views.HistoricoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Histórico de pedidos" Style="{StaticResource Titulo}" />
            <TextBlock Style="{StaticResource Dica}" Text="Do mais recente para o mais antigo. Somente pedidos ENTREGUES podem ser avaliados (uma vez)." />
            <TextBlock x:Name="TxtVazio" Text="Você ainda não fez pedidos." Style="{StaticResource Dica}" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAtualizar" Content="Atualizar" Click="BtnAtualizar_Click" />
            <Button x:Name="BtnVoltar" Content="Voltar" Click="BtnVoltar_Click" />
        </StackPanel>

        <DataGrid x:Name="DgHistorico">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nº" Binding="{Binding PedidoId, Mode=OneWay}" Width="50" />
                <DataGridTextColumn Header="Data" Binding="{Binding DataHoraTexto, Mode=OneWay}" Width="130" />
                <DataGridTextColumn Header="Restaurante" Binding="{Binding NomeRestaurante, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotalTexto, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusTexto, Mode=OneWay}" Width="140" />
                <DataGridTextColumn Header="Avaliação" Binding="{Binding AvaliacaoTexto, Mode=OneWay}" Width="95" />
                <DataGridTemplateColumn Header="Ações" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Detalhes" Tag="{Binding PedidoId}" Click="BtnDetalhes_Click" MinWidth="0" Margin="2" Padding="6,0" />
                                <Button Content="Avaliar" Tag="{Binding PedidoId}" IsEnabled="{Binding PodeAvaliar, Mode=OneWay}" Click="BtnAvaliar_Click" MinWidth="0" Margin="2" Padding="6,0" />
                                <Button Content="Repetir" Tag="{Binding PedidoId}" Click="BtnRepetir_Click" MinWidth="0" Margin="2" Padding="6,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
