<UserControl x:Class="RotaDoSabor.Wpf.Views.RestaurantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Restaurantes" Style="{StaticResource Titulo}" />

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtBusca" Grid.Column="0" Margin="0,2,8,8" />
            <ComboBox x:Name="CmbCategoria" Grid.Column="1" DisplayMemberPath="Nome" SelectionChanged="CmbCategoria_SelectionChanged" />
            <Button x:Name="BtnFiltrar" Grid.Column="2" Content="Pesquisar" IsDefault="True" Click="BtnFiltrar_Click" Margin="8,2,0,8" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnVoltar" Content="Voltar" Click="BtnVoltar_Click" />
            <Button x:Name="BtnCarrinho" Content="Carrinho" Click="BtnCarrinho_Click" />
        </StackPanel>

        <TextBlock x:Name="TxtVazio" DockPanel.Dock="Top" Text="Nenhum restaurante encontrado." Style="{StaticResource Dica}" Visibility="Collapsed" />

        <ListBox x:Name="LstRestaurantes" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ver cardápio" Tag="{Binding Id}" Click="BtnVerCardapio_Click" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="Bold" />
                                <TextBlock>
                                    <Run Text="{Binding Categoria, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding AvaliacaoTexto, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding TempoEntregaTexto}" Foreground="DimGray" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
