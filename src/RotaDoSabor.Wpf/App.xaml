<Application x:Class="RotaDoSabor.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!-- Estilos mínimos: apenas espaçamentos e tamanhos de fonte. Sem imagens, animações ou bibliotecas externas. -->
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,4,0,0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,16,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Dica" TargetType="TextBlock">
            <Setter Property="Foreground" Value="DimGray" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Application.Resources>
</Application>
