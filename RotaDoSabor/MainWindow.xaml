<Window x:Class="RotaDoSabor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rota do Sabor"
        Width="1000" Height="680"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource CorFundo}">
    <!-- Casca da aplicação: as telas (Views) são trocadas dentro deste ContentControl. -->
    <ContentControl x:Name="ConteudoPrincipal" IsTabStop="False"/>
</Window>
