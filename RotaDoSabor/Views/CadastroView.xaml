<UserControl x:Class="RotaDoSabor.Views.CadastroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="clr-namespace:RotaDoSabor.Views.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <componentes:PainelMarca Grid.Column="0"/>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340" Margin="0,32">

                <TextBlock Text="Criar conta" Style="{StaticResource Titulo}"/>
                <TextBlock Text="Leva menos de um minuto."
                           Style="{StaticResource Subtitulo}" Margin="0,6,0,24"/>

                <TextBlock Text="Usuário" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="TxtUsuario" Style="{StaticResource CampoTexto}" MaxLength="30"/>
                <TextBlock Text="De 3 a 30 caracteres: letras, números, _ . ou -" Style="{StaticResource TextoDica}"/>

                <TextBlock Text="E-mail" Style="{StaticResource Rotulo}" Margin="0,16,0,6"/>
                <TextBox x:Name="TxtEmail" Style="{StaticResource CampoTexto}" MaxLength="120"/>

                <TextBlock Text="Senha" Style="{StaticResource Rotulo}" Margin="0,16,0,6"/>
                <PasswordBox x:Name="TxtSenha" Style="{StaticResource CampoSenha}" MaxLength="64"/>
                <TextBlock Text="Mínimo de 6 caracteres" Style="{StaticResource TextoDica}"/>

                <TextBlock Text="Confirmar senha" Style="{StaticResource Rotulo}" Margin="0,16,0,6"/>
                <PasswordBox x:Name="TxtConfirmacao" Style="{StaticResource CampoSenha}" MaxLength="64"/>

                <Border x:Name="CaixaErro" Visibility="Collapsed" Background="{StaticResource CorErroFundo}"
                        CornerRadius="8" Padding="12,10" Margin="0,18,0,0">
                    <TextBlock x:Name="TxtErro" Style="{StaticResource TextoErro}"/>
                </Border>

                <Button x:Name="BtnConfirmar" Content="Confirmar" IsDefault="True"
                        Style="{StaticResource BotaoPrimario}" Margin="0,24,0,0" Click="BtnConfirmar_Click"/>
                <Button Content="Voltar" IsCancel="True"
                        Style="{StaticResource BotaoLink}" Margin="0,10,0,0" Click="BtnVoltar_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
