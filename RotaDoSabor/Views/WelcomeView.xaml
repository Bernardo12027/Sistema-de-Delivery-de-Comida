<UserControl x:Class="RotaDoSabor.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="clr-namespace:RotaDoSabor.Views.Components">
    <!-- Tela inicial: marca + botões Login e Cadastro (conforme o esquema do Excalidraw). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <componentes:PainelMarca Grid.Column="0"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <TextBlock Text="Bem-vindo!" Style="{StaticResource Titulo}"/>
            <TextBlock Text="Entre na sua conta ou crie uma nova para começar a pedir."
                       Style="{StaticResource Subtitulo}" Margin="0,8,0,32"/>

            <Button x:Name="BtnLogin" Content="Login"
                    Style="{StaticResource BotaoPrimario}" Click="BtnLogin_Click"/>
            <Button x:Name="BtnCadastro" Content="Cadastro"
                    Style="{StaticResource BotaoSecundario}" Margin="0,14,0,0" Click="BtnCadastro_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
